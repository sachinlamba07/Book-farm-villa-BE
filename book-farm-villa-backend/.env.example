# Copy this to .env (or set as real environment variables) for local development.
# In production, set these in your hosting provider's environment/secrets settings.

DB_URL=jdbc:postgresql://localhost:5432/bookfarmvilla
DB_USERNAME=postgres
DB_PASSWORD=postgres

JWT_SECRET=change-this-to-a-long-random-string-at-least-32-characters
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:5173

SEED_ADMIN_EMAIL=admin@bookfarmvilla.com
SEED_ADMIN_PASSWORD=ChangeMe123!

PORT=8080
